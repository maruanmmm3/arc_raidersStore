# Copia este archivo como .env.local y rellena los valores.
# Todo lo que empieza por VITE_ llega al navegador: nunca pongas aquí claves secretas.

# Local: los imprime `npx supabase start`. Nube: Project Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Moneda de los precios (código ISO 4217)
VITE_CURRENCY=ARS

# true = muestra el aviso de proyecto demo en todas las páginas
VITE_DEMO_MODE=true
